# 伺服器
PORT=3000
# 對外可存取的網址（Meta Webhook 與追蹤連結會用到，不要加結尾斜線）
PUBLIC_URL=https://your-domain.example.com

# 後台登入密碼（必填）
ADMIN_PASSWORD=change-me
# 簽署登入 Cookie 用的隨機字串（必填，隨便一段長亂數）
SESSION_SECRET=change-me-to-a-long-random-string

# Meta App 設定
# 在 Meta 開發者後台 Webhook 設定頁填的「驗證權杖」，自己決定一串字即可
META_VERIFY_TOKEN=my-verify-token
# Meta App 的 App Secret（用來驗證 Webhook 簽章，強烈建議填）
META_APP_SECRET=
# Graph API 版本
META_GRAPH_VERSION=v21.0

# SQLite 資料庫檔案位置
DATABASE_PATH=./data/app.db
